@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(LibXml2)
find_dependency(Iconv)
if(NOT WIN32)
  find_dependency(Threads)
endif()
if(@VITAMTP_USB_SUPPORT@)
  # Keep dependency search paths local even if find_dependency returns early.
  function(_vitamtp_find_libusb)
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(LibUSB)
  endfunction()
  _vitamtp_find_libusb()
  if(NOT TARGET LibUSB::LibUSB)
    set(VitaMTP_FOUND FALSE)
    set(VitaMTP_NOT_FOUND_MESSAGE "VitaMTP requires LibUSB")
    return()
  endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/VitaMTPTargets.cmake")
check_required_components(VitaMTP)
