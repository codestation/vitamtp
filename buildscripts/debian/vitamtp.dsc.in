Format: 3.0 (quilt)
Source: vitamtp
Binary: libvitamtp-dev, libvitamtp5
Architecture: any
Version: @VERSION@
Maintainer: codestation <codestation@megpoid.dev>
Homepage: https://github.com/codestation/vitamtp
Standards-Version: 4.7.0
Vcs-Browser: https://github.com/codestation/vitamtp
Vcs-Git: https://github.com/codestation/vitamtp.git
DEBTRANSFORM-RELEASE: 1
DEBTRANSFORM-TAR: vitamtp-2.5.11.tar.gz
DEBTRANSFORM-FILES-TAR: debian.tar.xz
Build-Depends: debhelper-compat (= 13), cmake (>= 3.21), pkg-config, libusb-1.0-0-dev, libxml2-dev
Package-List:
 libvitamtp-dev deb libdevel optional arch=any
 libvitamtp5 deb libs optional arch=any
