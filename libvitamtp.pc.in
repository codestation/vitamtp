prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@VITAMTP_PC_LIBDIR@
includedir=@VITAMTP_PC_INCLUDEDIR@

Name: libvitamtp
Description: Media transfer with PlayStation Vita
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lvitamtp
Libs.private: @VITAMTP_PC_PRIVATE_LIBS@
Requires.private: libxml-2.0 @VITAMTP_PC_LIBUSB@
Cflags: -I${includedir}
