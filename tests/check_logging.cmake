foreach(level default 0 1 3 7 15)
  set(args "")
  if(NOT level STREQUAL "default")
    list(APPEND args "${level}")
  endif()
  execute_process(COMMAND "${TEST_EXECUTABLE}" ${args}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE logs)
  if(NOT result STREQUAL "0" OR NOT output STREQUAL "")
    message(FATAL_ERROR "Logging test failed for level ${level}: ${result}\n${output}\n${logs}")
  endif()

  # Windows streams use CRLF; retain the caller name and validate its line.
  string(REPLACE "\r\n" "\n" logs "${logs}")
  string(REGEX REPLACE "emit_logs\\[[1-9][0-9]*\\]" "emit_logs[LINE]" logs "${logs}")
  set(expected "")
  if(level STREQUAL "default" OR level GREATER_EQUAL 1)
    string(APPEND expected "VitaMTP: error 42\n")
  endif()
  if(level GREATER_EQUAL 3)
    string(APPEND expected "VitaMTP: info message\n")
  endif()
  if(level GREATER_EQUAL 7)
    string(APPEND expected "VitaMTP: verbose\n")
  endif()
  if(level GREATER_EQUAL 15)
    string(APPEND expected "VitaMTP emit_logs[LINE]: debug\n")
  endif()
  if(NOT logs STREQUAL expected)
    message(FATAL_ERROR "Unexpected logging for level ${level}.\nExpected:\n${expected}\nActual:\n${logs}")
  endif()
endforeach()
